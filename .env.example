DISPLAY_HOST=192.168.1.37
DISPLAY_PIN=000000
DISPLAY_MAC=00:00:00:00:00:00
DISPLAY_SLEEP_AFTER=20

# Docker / server
# LAN address the display fetches images from (auto-detected if unset; required
# when the container can't see the host's eth0/en0, e.g. Docker Desktop)
LOCAL_IP=
PORT=3001
# Timezone for scheduled wake timers — should match the display's clock
TZ=America/Chicago
